# Ollama Environment Variables Template for EnterpriseAI
# Rendered from this template during install/repair.
# Do not edit this file directly on workstations.
# See C:\ProgramData\EnterpriseAI\Config\ollama.env for the active environment file.
#
# TODO: Verify OLLAMA_HOST format and behavior for custom loopback binding on current Ollama Windows release.
# Reference: https://github.com/ollama/ollama/blob/main/docs/faq.md

# Bind Ollama only to the designated loopback address.
# Do NOT change to 0.0.0.0, 127.0.0.1, or any LAN address.
OLLAMA_HOST=http://127.0.0.2:11434

# Model storage path. Populated by separate model content packages.
OLLAMA_MODELS=C:\ProgramData\EnterpriseAI\Models

# Keep models loaded in memory. Adjust based on workstation memory.
# OLLAMA_KEEP_ALIVE=5m

# Do not allow Ollama to initiate model pulls via the API.
# TODO: Verify the correct Ollama environment variable to disable API-based model pulls.
# OLLAMA_NO_PULL=1

# Disable telemetry
OLLAMA_NOHISTORY=1
